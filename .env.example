# ---- App ----
NODE_ENV=development
PORT=3000
# loopback saja; reverse proxy yang menghadap publik
HOST=127.0.0.1
APP_URL=http://localhost:3000
APP_NAME=Beework

# ---- Database ----
DATABASE_URL=postgres://beework:beework@localhost:5432/beework
DB_POOL_MAX=10

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Captcha di pendaftaran ----
# turnstile | hcaptcha | recaptcha | none. Secret kosong = nonaktif (peringatan di produksi).
# Turnstile: buat widget di dash.cloudflare.com → Turnstile; kunci uji resmi untuk dev:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (selalu lolos)
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
CAPTCHA_EXPECTED_HOSTNAME=
CAPTCHA_MIN_SCORE=0.5

# ---- Rate limit ----
# Percaya X-Forwarded-For hanya bila koneksi datang dari loopback (nginx lokal).
TRUST_PROXY=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MIN=300

# ---- Job runner ----
JOBS_ENABLED=true
JOBS_POLL_MS=5000
# Setelah deadline, owner masih punya N hari untuk review; lewat itu task kedaluwarsa
# dan sisa escrow ledger dikembalikan. Samakan dengan REVIEW_PERIOD kontrak (7 hari).
TASK_REVIEW_PERIOD_DAYS=7

# ---- Platform economics ----
PLATFORM_FEE_BPS=500          # 5% fee dari nilai task
REFERRAL_SHARE_BPS=5000       # 50% dari platform fee ke referrer
DEFAULT_CURRENCY=USDC

# Akun admin awal — hanya dibuat kalau ini diisi saat menjalankan db:seed
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Integrations (opsional, isi saat dipakai) ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

PRIVY_APP_ID=
PRIVY_APP_SECRET=

TWITTER_OAUTH_CLIENT_ID=
TWITTER_OAUTH_CLIENT_SECRET=

# ---- Eskrow on-chain (kontrak BeeworkEscrow, EVM) ----
# Kosongkan EVM_ESCROW_ADDRESS untuk menonaktifkan; task beraset EVM akan ditolak.
EVM_CHAIN_ID=10143
EVM_CHAIN_NAME=Monad Testnet
EVM_NATIVE_SYMBOL=MON
EVM_RPC_URL=https://testnet-rpc.monad.xyz
EVM_ESCROW_ADDRESS=
# Hot wallet platform. Alamatnya jadi `reviewer` saat owner memanggil fund();
# kuncinya dipakai backend untuk award(). Isi saldo gas secukupnya saja.
EVM_REVIEWER_PRIVATE_KEY=
EVM_INDEXER_START_BLOCK=0
EVM_INDEXER_INTERVAL_MS=5000
# blok per panggilan getLogs; RPC publik Monad menolak > 100
EVM_LOGS_BLOCK_SPAN=100
EVM_EXPLORER_URL=https://testnet.monadexplorer.com
# polling getLogs lewat RPC; set false hanya kalau Ghost sudah jalan dan ingin hemat RPC
EVM_INDEXER_ENABLED=true

# ---- GhostGraph (opsional, sumber event kedua) — lihat contracts/ghost/README.md ----
GHOST_GRAPHQL_URL=
GHOST_API_KEY=
EVM_CONFIRMATIONS=2

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_ESCROW_PROGRAM_ID=
SOLANA_TREASURY_SECRET_KEY=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
